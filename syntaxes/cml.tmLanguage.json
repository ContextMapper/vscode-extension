{
    "name": "Context Mapper DSL",
    "scopeName": "source.cml",
    "fileTypes": [
        "cml"
    ],
    "repository": {
        "general": {
            "patterns": [
                {
                    "include": "#linecomment"
                },
                {
                    "include": "#blockcomment"
                },
                {
                    "include": "#stringsSingle"
                },
                {
                    "include": "#stringsDouble"
                },
                {
                    "include": "#phrases"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#keywords"
                }
            ]
        },
        "linecomment": {
            "name": "comment.line.double-slash.cml",
            "match": "//.*$"
        },
        "blockcomment": {
            "name": "comment.block.cml",
            "begin": "/\\*",
            "end": "\\*/"
        },
        "stringsSingle": {
            "name": "string.quoted.single.cml",
            "begin": "'",
            "end": "'"
        },
        "stringsDouble": {
            "name": "string.quoted.double.cml",
            "begin": "\"",
            "end": "\""
        },
        "phrases": {
            "name": "keyword.control.cml",
            "match": "(?<!\\w)(with\\s+the\\s+following\\s+externally\\s+observable\\s+and/or\\s+internally\\s+auditable\\s+behavior:|stakeholders\\s+expect\\s+it\\s+to\\s+promote,\\s+protect\\s+or\\s+create|possibly\\s+degrading\\s+or\\s+prohibiting|running\\s+the\\s+risk\\s+of\\s+harms\\s+such\\s+as|In\\s+the\\s+context\\s+of\\s+the\\s+SOI,|expecting\\s+benefits\\s+such\\s+as|When\\s+the\\s+SOI\\s+executes|as\\s+demonstrated\\s+in|accepting\\s+that|realization\\s+of|unmarshall\\s+to|delegates\\s+to|initiated\\s+by|reduction\\s+of|emits\\s+event|with\\s+their|I\\s+want\\s+to|more\\s+than|and\\s+that|split\\s+by|with\\s+its|I\\s+value|so\\s+that|As\\s+an|As\\s+a)(?!\\w)"
        },
        "types": {
            "name": "support.type.cml",
            "match": "(?<!\\w)(PagingParameter|PagedResult|BigDecimal|BigInteger|Collection|Timestamp|DateTime|Boolean|Integer|boolean|Double|Object|String|double|Float|float|Blob|Clob|Date|List|Long|long|void|Bag|Key|Map|Set|int)(?!\\w)"
        },
        "keywords": {
            "name": "keyword.control.cml",
            "match": "(?<!\\w)(implementationTechnology|availabilityCriticality|consistencyCriticality|domainVisionStatement|TacticDDDApplication|structuralVolatility|Downstream-Upstream|Upstream-Downstream|discriminatorColumn|discriminatorLength|likelihoodForChange|securityAccessGroup|securityCriticality|DataTransferObject|aggregateLifecycle|databaseJoinColumn|discriminatorValue|Customer-Supplier|GENERIC_SUBDOMAIN|SUPPORTING_DOMAIN|Supplier-Customer|contentVolatility|databaseJoinTable|discriminatorType|exposedAggregates|optimisticLocking|storageSimilarity|SYSTEM_LANDSCAPE|StakeholderGroup|creditCardNumber|downstreamRights|responsibilities|userRequirements|ApplicationPart|inheritanceType|secondaryActors|BoundedContext|DECISION_MAKER|OPINION_LEADER|ORGANIZATIONAL|SUSTAINABILITY|ValueNarrative|ValueWeigthing|databaseColumn|knowledgeLevel|INCLUSIVENESS|Shared-Kernel|ValueRegister|aggregateRoot|businessModel|databaseTable|opposingValue|AccessObject|CUSTOM_BUILT|CommandEvent|Coordination|SINGLE_TABLE|Stakeholders|TRANSPARENCY|ValueCluster|consequences|databaseType|demonstrator|interactions|relatedValue|scriptAssert|securityZone|APPLICATION|Application|CORE_DOMAIN|DomainEvent|Partnership|Stakeholder|ValueObject|assertFalse|association|basePackage|description|orderColumn|stakeholder|userStories|ContextMap|INFLUENCER|INNOVATION|MONOPOLIST|PERFECTION|Repository|VETO_RIGHT|assertTrue|changeable|decimalMax|decimalMin|implements|persistent|webservice|Aggregate|BasicType|COMMODITY|Subdomain|UNDEFINED|UserStory|ValueEpic|auditable|belongsTo|condition|construct|evolution|immutable|influence|operation|protected|queueName|read-only|reference|subscribe|topicName|transient|AUTONOMY|CONCRETE|Consumer|FAIRNESS|Resource|abstract|contains|eventBus|external|features|interest|notBlank|notEmpty|nullable|opposite|priority|promoted|realizes|required|scaffold|supports|triggers|useCases|validate|CONTROL|Command|FEATURE|GENESIS|INTEGER|MONITOR|PRIVACY|PRODUCT|RESPECT|Service|UseCase|benefit|cascade|command|extends|groupBy|inverse|neutral|orderBy|orderby|ordinal|package|pattern|private|publish|reduced|refines|DELETE|Domain|Entity|JOINED|MEDIUM|Module|NORMAL|RARELY|STRING|SYSTEM|action|create|delete|digits|future|harmed|impact|import|inject|isCore|length|public|return|select|throws|unique|update|values|AS_IS|Event|OFTEN|TO_BE|TRUST|Trait|Value|actor|build|cache|email|event|fetch|index|level|nogap|owner|query|range|scope|state|valid|write|CARE|CHAR|Flow|HIGH|HUGE|META|None|POST|TEAM|TINY|core|enum|good|hint|past|path|read|size|type|with|ACL|ACT|GET|LOW|OHS|PUT|are|bad|def|for|gap|key|map|max|min|not|the|url|CF|PL|SK|an|in|is|of|to|C|D|O|P|S|U|X|a|o|x)(?!\\w)"
        }
    },
    "patterns": [
        {
            "include": "#general"
        }
    ]
}
